# Sublet Sniper. Every integration has a mock mode: with NO keys, text chat + browser voice + snapshot/live Craigslist + mock mail/calendar all work.

# ---- LLM (first one present wins: Anthropic > xAI > OpenAI; none = deterministic offline agent) ----
ANTHROPIC_API_KEY=            # https://console.anthropic.com/settings/keys
ANTHROPIC_MODEL=claude-sonnet-4-5
XAI_API_KEY=                  # https://console.x.ai  (OpenAI-compatible, https://api.x.ai/v1)
XAI_MODEL=grok-4
OPENAI_API_KEY=               # https://platform.openai.com/api-keys
OPENAI_MODEL=gpt-4.1-mini
LLM_PROVIDER=                 # optional: force anthropic | xai | openai | mock

# ---- Craigslist ----
CRAIGSLIST_LIVE=1             # 0 = use the bundled snapshot only (765 real SF listings, 2026-10-24). Live fetch is polite: >=3s between requests, browser UA, 10 min cache.

# ---- Email: AgentMail (agent's own mailbox) ----
AGENTMAIL_API_KEY=            # https://console.agentmail.to  -> API keys
AGENTMAIL_INBOX_ID=           # inbox address you created there, e.g. sublet-sniper@agentmail.to
WEBHOOK_TOKEN=                # random string; set the AgentMail webhook to https://<host>/api/mail/webhook?token=<WEBHOOK_TOKEN> (event message.received). Locally use the "Check mail" button (polls).
MAIL_MODE=                    # optional: mock to force mock mail
DEMO_LANDLORD_EMAIL=landlord-demo@example.com   # teammate playing the DEMO landlord. The ONLY addresses the agent may email:
DEMO_ALLOWED_EMAILS=          # comma-separated extra allowlist (teammates). Real landlords are never emailed.

# ---- Google Calendar (viewings) ----
GOOGLE_CLIENT_ID=             # https://console.cloud.google.com/apis/credentials (OAuth client, enable Calendar API)
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=         # get one with https://developers.google.com/oauthplayground (scope https://www.googleapis.com/auth/calendar, "use your own OAuth credentials")
GOOGLE_CALENDAR_ID=primary
CALENDAR_MODE=                # optional: mock

# ---- Voice ----
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=   # optional: https://elevenlabs.io/app/conversational-ai  (adds the ElevenLabs widget). Without it: browser Web Speech API (Chrome).

# ---- Phone calls: the agent calls the DEMO landlord and negotiates by voice (ElevenLabs Agents, outbound) ----
# Live only when API key + agent id + phone number id + DEMO_LANDLORD_PHONE are all set. VOICE_MODE=mock = scripted simulator.
ELEVENLABS_API_KEY=           # https://elevenlabs.io/app/settings/api-keys (scopes: Agents read/write)
ELEVENLABS_AGENT_ID=          # printed by: node --env-file=.env.local scripts/elevenlabs-setup.mjs   (needs APP_URL + WEBHOOK_TOKEN)
ELEVENLABS_PHONE_NUMBER_ID=   # ElevenLabs > Agents > Phone numbers: import your Twilio number, assign the agent, copy its id
ELEVENLABS_WEBHOOK_SECRET=    # ElevenLabs post-call webhook -> https://<host>/api/voice/webhook (HMAC secret shown on creation)
ELEVENLABS_TELEPHONY=         # optional: sip (SIP trunk number) instead of twilio
DEMO_LANDLORD_PHONE=          # E.164, e.g. +14155550123. The ONLY number the agent may call (the presenter's phone):
DEMO_ALLOWED_PHONES=          # comma-separated extra allowlist. Real landlords are never called.
DEMO_LANDLORD_NAME=           # optional: how the agent greets the landlord ("Hi, is this Sam?")
VOICE_MODE=                   # optional: mock to simulate calls (no keys needed)
AUTOPILOT_CHANNEL=            # call | email. Default: call when calls are available (after the first email).
APP_URL=                      # public https URL, used only by scripts/elevenlabs-setup.mjs for the tool webhooks

# ---- Renter profile used in landlord replies ----
RENTER_NAME=Nicolás Arias
RENTER_EMAIL=

# Accounts (optional, multi-tenant). Without these the app is single-tenant. AUTH_MODE=off forces single-tenant.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
POSTGRES_URL_NON_POOLING=   # scripts/migrate.mjs only
